{
  "name": "hidden-tunes-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --max-workers 1",
    "start:clear": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --clear --max-workers 1",
    "start:expo": "expo start",
    "verify:tunnel-deps": "node ./scripts/verify-dev-tunnel-deps.js",
    "verify:preview-config": "node ./scripts/verify-preview-config.js",
    "start:tunnel": "node ./scripts/start-expo-tunnel.js",
    "start:tunnel:clear": "node ./scripts/start-expo-tunnel.js --clear",
    "start:dev-client": "node ./scripts/start-expo-tunnel.js --dev-client",
    "start:dev-client:tunnel": "node ./scripts/start-expo-tunnel.js --dev-client",
    "start:dev-client:clear": "node ./scripts/start-expo-tunnel.js --dev-client --clear",
    "start:dev-client:lan": "npx expo start --dev-client --host lan --max-workers 1",
    "start:dev-client:localhost": "npx expo start --dev-client --host localhost --max-workers 1",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:dev-client:android": "eas build --profile developmentClient --platform android",
    "build:dev-client:ios": "eas build --profile developmentClient --platform ios",
    "postinstall": "node ./scripts/patch-android-gradle-foojay.mjs",
    "eas-build-post-install": "node ./scripts/eas-prebuild-standalone.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "node --max-old-space-size=4096 ./node_modules/expo/bin/cli start --web --max-workers 1",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:sports-frontend": "npx tsx scripts/test-sports-frontend.ts",
    "test:localization": "npx tsx scripts/test-localization.mjs",
    "test:mature-podcast-device-lock": "node scripts/test-mature-podcast-device-lock.mjs",
    "validate:localization": "npx tsx scripts/validate-localization.mjs"
  },
  "dependencies": {
    "@expo/config": "^57.0.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@supabase/supabase-js": "^2.105.4",
    "expo": "57.0.13",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.6",
    "expo-local-authentication": "~57.0.2",
    "expo-media-control": "~1.0.12",
    "expo-router": "~57.0.13",
    "expo-screen-orientation": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.14",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "tsx": "4.23.8",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-modules-jsi"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
