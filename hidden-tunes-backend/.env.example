# Junction 2 — local only. Defaults are off.
# Do not enable EXTERNAL_DISCOVERY_ENABLED or BRIDGE_PLAYBACK_ENABLED in production yet.
EXTERNAL_DISCOVERY_ENABLED=false
BRIDGE_PLAYBACK_ENABLED=false
MEDIA_BRIDGE_BASE_URL=
MEDIA_BRIDGE_J2_SECRET=
# Released client requires an absolute HTTPS origin (relative /api/media/... is dropped).
# Production value. Do not put Bridge/Gateway hosts here.
PUBLIC_API_BASE_URL=https://api.hiddentunes.com
J2_SEARCH_TIMEOUT_MS=1200
J2_SEARCH_LIMIT=5
J2_TEST_FIXTURE_ENABLED=false
J2_TEST_FIXTURE_KEYS=archive.org:testmp3testfile
# Owner canary is independent of the global flags. Leave disabled except during a controlled test.
# MODE=open  -> any non-empty search query may use external discovery (owner testing only)
# MODE=queries -> only J2_OWNER_CANARY_QUERIES / J2_OWNER_CANARY_QUERY
J2_OWNER_CANARY_ENABLED=false
J2_OWNER_CANARY_MODE=queries
J2_OWNER_CANARY_QUERY=
J2_OWNER_CANARY_QUERIES=
J2_OWNER_CANARY_UPSTREAM_QUERY=
J2_OWNER_CANARY_SOURCE_KEYS=
J2_WORKER_ROLE=OWNER_CANARY_WORKER
