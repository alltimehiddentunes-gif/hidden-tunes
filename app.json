{
  "expo": {
    "name": "Hidden Tunes",
    "slug": "hidden-tunes",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "hiddentunes",
    "userInterfaceStyle": "dark",
    "description": "Discover and stream music with Hidden Tunes.",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9cf7fc48-6bf7-4ccc-8fe1-8b793530e70c"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hiddentunes.app",
      "buildNumber": "1.0.213",
      "icon": "./assets/images/icon.png",
      "entitlements": {
        "com.apple.developer.carplay-audio": true
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hiddentunes.app",
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Hidden Tunes uses Face ID to protect access to Mature Podcasts."
        }
      ],
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-media-control",
        {
          "enableBackgroundAudio": true,
          "audioSessionCategory": "playback"
        }
      ],
      "./plugins/hidden-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cf7fc48-6bf7-4ccc-8fe1-8b793530e70c"
      }
    },
    "owner": "hiddentunes_1"
  }
}
